# Production settings for docker-compose.prod.yml.
# Copy to .env in the repository root ON THE SERVER and fill in. Never commit the real file.

# Public domain (its DNS A record must point to this server)
DOMAIN=schaefers.example.de

# Email for Let's Encrypt certificate notices
ACME_EMAIL=admin@example.de

# Database password. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-generated-password

# Login for the browser password prompt (protects the whole site until real user login exists).
BASIC_AUTH_USER=verkauf
# bcrypt hash of the password, with every "$" doubled to "$$". Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR-PASSWORD' | sed 's/\$/$$/g'
BASIC_AUTH_HASH=replace-with-generated-hash
