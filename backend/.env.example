# Copy to backend/.env and adjust. Never commit the real .env file.

# Application
APP_ENV=development
APP_NAME="Angebotsassistent Verkaufsinnendienst"
LOG_LEVEL=INFO

# PostgreSQL (matches docker-compose.yml defaults; placeholder credentials for local development only)
DATABASE_URL=postgresql+psycopg://quotation:change-me-locally@localhost:5432/quotation

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
